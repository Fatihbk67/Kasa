{
  "uid": "kasa-overview",
  "title": "Kasa",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Sonucu bilinmeyen banka işlemleri",
      "description": "Sürekli yüksekse banka veya kurtarma işi sorunludur.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "kasa_backlog_payment_operations" }]
    },
    {
      "id": 2,
      "title": "Yoldaki toplu ödemeler",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "kasa_backlog_payouts" }]
    },
    {
      "id": 3,
      "title": "Sıradaki webhook'lar",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "kasa_backlog_webhook_deliveries" }]
    },
    {
      "id": 4,
      "title": "Ödeme işlemleri (saniyede)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type, status) (rate(kasa_payment_operations_total[5m]))",
          "legendFormat": "{{type}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "API gecikmesi p95",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"/api/.*\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Webhook denemeleri (saniyede)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(kasa_webhook_attempts_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Mutabakat farkları",
      "description": "Sıfırdan farklıysa bir insanın incelemesi gerekir.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(kasa_reconciliation_discrepancies_total[1d]))",
          "legendFormat": "{{kind}}"
        }
      ]
    }
  ]
}
